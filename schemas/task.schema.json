{
  "$comment": "Output of `confidant tasks spec --json`: one entry per scheduled task the install skill creates with automation_update. kind, name, rrule, prompt, status, executionEnvironment, reasoningEffort and notificationPolicy (when not null) are passed to that tool as is; cwd is the vault, whose Codex project id goes in projectId.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "key",
      "kind",
      "name",
      "rrule",
      "prompt",
      "status",
      "executionEnvironment",
      "reasoningEffort",
      "notificationPolicy",
      "cwd"
    ],
    "additionalProperties": false,
    "properties": {
      "key": {
        "enum": [
          "brain_update",
          "opportunity_scanner",
          "morning_brief",
          "meeting_prep",
          "follow_up_radar",
          "weekly_review",
          "health_check",
          "brain_cleanup",
          "check_in",
          "finish_sorting"
        ]
      },
      "kind": {
        "const": "cron",
        "$comment": "standalone: every run is its own chat in Scheduled; never heartbeat"
      },
      "name": {
        "type": "string"
      },
      "rrule": {
        "type": "string",
        "pattern": "^FREQ=(HOURLY|DAILY|WEEKLY|MONTHLY)(;[A-Z]+=[A-Z0-9,+-]+)*$"
      },
      "fallbackRrules": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "$comment": "create one task per rule if the combined rule is rejected"
      },
      "prompt": {
        "type": "string",
        "minLength": 40
      },
      "status": {
        "const": "ACTIVE"
      },
      "executionEnvironment": {
        "const": "local"
      },
      "reasoningEffort": {
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "notificationPolicy": {
        "enum": [
          null,
          "failed_runs_only"
        ],
        "$comment": "null keeps Codex's default notifications; failed_runs_only still lists every run in Scheduled"
      },
      "cwd": {
        "type": "string"
      },
      "temporary": {
        "type": "boolean"
      }
    }
  }
}
