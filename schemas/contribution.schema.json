{
  "$comment": "What Codex writes after sorting one batch: .confidant/contrib/<batch_id>.json. The engine validates it, fingerprints each item, and merges it into notes. source_refs are record ids from the batch. Dates are YYYY-MM-DD in the person's time zone.",
  "type": "object",
  "required": [
    "batch_id"
  ],
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "type": "string"
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "companies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/company"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "meetings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/meeting"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "commitments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commitment"
      }
    },
    "ideas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/idea"
      }
    },
    "opportunities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opportunity"
      }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knowledge"
      }
    },
    "identity": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identityFix"
      }
    },
    "review": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewItem"
      }
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+:.+$"
      }
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "bullet": {
      "type": "object",
      "required": [
        "date",
        "text",
        "source_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "text": {
          "type": "string",
          "minLength": 3,
          "maxLength": 600
        },
        "source_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "person": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "person_id": {
          "type": "string",
          "$comment": "canonical id from the dossier when known"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "$comment": "persona vocabulary, e.g. client, investor, candidate, teammate, family, vendor"
        },
        "company": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "relationship": {
          "type": "string",
          "maxLength": 300
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bullets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bullet"
          }
        }
      }
    },
    "company": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "maxLength": 600
        },
        "people": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bullets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bullet"
          }
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "waiting",
            "stalled",
            "done",
            "idea"
          ]
        },
        "goal": {
          "type": "string",
          "maxLength": 400
        },
        "company": {
          "type": "string"
        },
        "people": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bullets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bullet"
          }
        }
      }
    },
    "meeting": {
      "type": "object",
      "required": [
        "title",
        "date",
        "source_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "people": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "company": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "key_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "due": {
                "$ref": "#/$defs/date"
              }
            }
          }
        },
        "source_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "title",
        "date",
        "source_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "decided_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string",
          "maxLength": 800
        },
        "against": {
          "type": "string",
          "maxLength": 600,
          "$comment": "what argued the other way"
        },
        "project": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "source_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "commitment": {
      "type": "object",
      "required": [
        "text",
        "direction",
        "counterpart",
        "date",
        "source_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 3,
          "maxLength": 400
        },
        "direction": {
          "enum": [
            "i_owe",
            "owed_to_me",
            "delegated"
          ]
        },
        "counterpart": {
          "type": "string",
          "$comment": "the other person's name"
        },
        "company": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "due": {
          "$ref": "#/$defs/date"
        },
        "status": {
          "enum": [
            "open",
            "done",
            "dropped"
          ]
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "source_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "idea": {
      "type": "object",
      "required": [
        "title",
        "date",
        "source_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "text": {
          "type": "string",
          "maxLength": 1200
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "people": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "project": {
          "type": "string"
        },
        "source_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "opportunity": {
      "type": "object",
      "required": [
        "title",
        "type",
        "date",
        "source_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "type": {
          "enum": [
            "pricing_ask",
            "upsell",
            "introduction",
            "stalled_proposal",
            "recurring_request",
            "possible_product",
            "renewal",
            "lead",
            "other"
          ]
        },
        "counterpart": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "next_step": {
          "type": "string",
          "maxLength": 300
        },
        "status": {
          "enum": [
            "open",
            "won",
            "lost",
            "stale"
          ]
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "source_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "knowledge": {
      "type": "object",
      "required": [
        "title",
        "text",
        "source_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "text": {
          "type": "string",
          "maxLength": 3000
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "source_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "identityFix": {
      "type": "object",
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "merge",
            "rename",
            "set_kind",
            "set_company",
            "not_a_person"
          ]
        },
        "person_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "company": {
          "type": "string"
        }
      }
    },
    "reviewItem": {
      "type": "object",
      "required": [
        "question",
        "source_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string",
          "minLength": 5,
          "maxLength": 400
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subject": {
          "type": "string",
          "$comment": "the note or name it is about"
        },
        "source_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    }
  }
}
